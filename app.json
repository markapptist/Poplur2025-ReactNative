{
  "expo": {
    "name": "Poplur",
    "slug": "poplur2025-react-native",
    "scheme": "poplur2025",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon-1024x1024.png",
    "userInterfaceStyle": "dark",
    "web": {
      "favicon": "./src/assets/favicon.ico",
      "name": "Poplur",
      "shortName": "Poplur",
      "description": "Poplur - location-based social app",
      "themeColor": "#E6120F",
      "backgroundColor": "#160226"
    },
    "ios": {
      "bundleIdentifier": "com.apptist.Poplur2025.reactnative",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Poplur needs camera access so you can record location-based posts.",
        "NSMicrophoneUsageDescription": "Poplur needs microphone access to record videos.",
        "NSPhotoLibraryUsageDescription": "Poplur needs photo library access so you can choose media to post.",
        "NSLocationWhenInUseUsageDescription": "Poplur needs your location to show nearby posts on the map."
      }
    },
    "android": {
      "package": "com.apptist.poplur2025.reactnative",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon-1024x1024.png",
        "backgroundColor": "#160226"
      },
      "permissions": ["CAMERA", "RECORD_AUDIO", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "READ_MEDIA_IMAGES", "READ_MEDIA_VIDEO"]
    },
    "plugins": ["expo-camera", "expo-image-picker", "expo-location"],
    "extra": {
      "firebaseProjectId": "poplur2025"
    }
  }
}
